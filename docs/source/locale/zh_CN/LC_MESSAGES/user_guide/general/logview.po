msgstr "**状态值说明**"

#: ../../../../../../../maxframe/docs/source/user_guide/general/logview.rst:105
msgid "**Preparing**: The DAG is being parsed and has not started execution."
msgstr "**Preparing**：DAG 正在解析，尚未开始执行。"

#: ../../../../../../../maxframe/docs/source/user_guide/general/logview.rst:106
msgid "**Running**: The DAG is running."
msgstr "**Running**：DAG 正在运行。"

#: ../../../../../../../maxframe/docs/source/user_guide/general/logview.rst:107
msgid "**Succeeded**: The DAG finished successfully."
msgstr "**Succeeded**：DAG 已成功完成。"

#: ../../../../../../../maxframe/docs/source/user_guide/general/logview.rst:108
msgid "**Failed**: The DAG failed."
msgstr "**Failed**：DAG 执行失败。"

#: ../../../../../../../maxframe/docs/source/user_guide/general/logview.rst:109
msgid "**Cancelling**: The DAG is being cancelled."
msgstr "**Cancelling**：DAG 正在取消。"

#: ../../../../../../../maxframe/docs/source/user_guide/general/logview.rst:110
msgid "**Cancelled**: The DAG has been cancelled."
msgstr "**Cancelled**：DAG 已取消。"

#: ../../../../../../../maxframe/docs/source/user_guide/general/logview.rst:113
msgid "Sub DAG details"
