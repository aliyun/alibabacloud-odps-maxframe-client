#: ../../source/reference/udf.rst:44
msgid ""
"Python ABI used by the remote runtime, for example ``\"cp311\"`` for CPython"
" 3.11."
msgstr "远程运行环境使用的 Python ABI 标识。例如，``\"cp311\"`` 表示 CPython 3.11。"

#: ../../source/reference/udf.rst:46
msgid "``options.function.default_running_options``"
msgstr "``options.function.default_running_options``"

