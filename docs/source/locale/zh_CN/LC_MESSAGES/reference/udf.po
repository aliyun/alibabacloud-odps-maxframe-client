msgid "``options.python_tag``"
msgstr "``options.python_tag``"

#: ../../source/reference/udf.rst:42
msgid "``str``"
msgstr "``str``"

#: ../../source/reference/udf.rst:43
msgid "Detected from the client interpreter"
