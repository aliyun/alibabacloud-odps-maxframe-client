#: ../../source/reference/liteframe/generated/maxframe.liteframe.LiteFrame.str.slice.rst:2
msgid "maxframe.liteframe.LiteFrame.str.slice"
msgstr ""

#: of pandas.core.strings.accessor.StringMethods.slice:1
msgid "Slice substrings from each element in the Series or Index."
msgstr "从 Series 或 Index 中的每个元素切片子字符串。"

#: of pandas.core.strings.accessor.StringMethods.slice:3
msgid ""
"Slicing substrings from strings in a Series or Index helps extract "
"specific portions of data, making it easier to analyze or manipulate "
"text. This is useful for tasks like parsing structured text fields or "
"isolating parts of strings with a consistent format."
msgstr "从 Series 或 Index 中的字符串切片子字符串有助于提取特定的数据部分，使分析或操作文本变得更加容易。这对于解析结构化文本字段或隔离具有统一格式的字符串部分等任务非常有用。"

#: ../../source/reference/liteframe/generated/maxframe.liteframe.LiteFrame.str.slice.rst
msgid "参数"
msgstr ""

#: of pandas.core.strings.accessor.StringMethods.slice:8
msgid "Start position for slice operation."
msgstr "切片操作的起始位置。"

#: of pandas.core.strings.accessor.StringMethods.slice:10
msgid "Stop position for slice operation."
msgstr "切片操作的结束位置。"

#: of pandas.core.strings.accessor.StringMethods.slice:12
msgid "Step size for slice operation."
msgstr "切片操作的步长大小。"

#: ../../source/reference/liteframe/generated/maxframe.liteframe.LiteFrame.str.slice.rst
msgid "返回"
msgstr ""

#: of pandas.core.strings.accessor.StringMethods.slice:15
msgid "Series or Index from sliced substring from original string object."
msgstr "从原始字符串对象切片子字符串得到的 Series 或 Index。"

#: ../../source/reference/liteframe/generated/maxframe.liteframe.LiteFrame.str.slice.rst
msgid "返回类型"
msgstr ""

#: of pandas.core.strings.accessor.StringMethods.slice:20
msgid ":py:obj:`LiteFrame.str.slice_replace`"
msgstr ""

#: of pandas.core.strings.accessor.StringMethods.slice:21
msgid "Replace a slice with a string."
msgstr "用字符串替换切片。"

#: of pandas.core.strings.accessor.StringMethods.slice:23
msgid ":py:obj:`LiteFrame.str.get`"
msgstr ""

#: of pandas.core.strings.accessor.StringMethods.slice:24
msgid ""
"Return element at position. Equivalent to `LiteFrame.str.slice(start=i, "
"stop=i+1)` with `i` being the position."
msgstr ""
"返回指定位置的元素。等价于 `LiteFrame.str.slice(start=i, stop=i+1)`，其中"
" `i` 为位置。"
