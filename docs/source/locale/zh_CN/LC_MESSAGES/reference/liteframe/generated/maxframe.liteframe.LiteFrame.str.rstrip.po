#: ../../source/reference/liteframe/generated/maxframe.liteframe.LiteFrame.str.rstrip.rst:2
msgid "maxframe.liteframe.LiteFrame.str.rstrip"
msgstr ""

#: of pandas.core.strings.accessor.StringMethods.rstrip:1
msgid "Remove trailing characters."
msgstr "删除尾随字符。"

#: of pandas.core.strings.accessor.StringMethods.rstrip:3
msgid ""
"Strip whitespaces (including newlines) or a set of specified characters "
"from each string in the Series/Index from right side. Replaces any non-"
"strings in Series with NaNs. Equivalent to :meth:`str.rstrip`."
msgstr ""
"从 Series/Index 中每个字符串的右侧删除空白字符（包括换行符）或一组指定的"
"字符。将 Series 中任何非字符串替换为 NaNs。等价于 :meth:`str.rstrip`。"

#: ../../source/reference/liteframe/generated/maxframe.liteframe.LiteFrame.str.rstrip.rst
msgid "参数"
msgstr ""

#: of pandas.core.strings.accessor.StringMethods.rstrip:8
msgid ""
"Specifying the set of characters to be removed. All combinations of this "
"set of characters will be stripped. If None then whitespaces are removed."
msgstr ""
"指定要删除的字符集。该字符集的所有组合都将被删除。如果为 None，则删除空白"
"字符。"

#: ../../source/reference/liteframe/generated/maxframe.liteframe.LiteFrame.str.rstrip.rst
msgid "返回"
msgstr ""

#: of pandas.core.strings.accessor.StringMethods.rstrip:13
msgid "Series or Index with the strings being stripped from the right side."
msgstr "从右侧去除空白字符后的 Series 或 Index。"

#: ../../source/reference/liteframe/generated/maxframe.liteframe.LiteFrame.str.rstrip.rst
msgid "返回类型"
msgstr ""

#: of pandas.core.strings.accessor.StringMethods.rstrip:18
msgid ":py:obj:`LiteFrame.str.strip`"
msgstr ""

#: of pandas.core.strings.accessor.StringMethods.rstrip:19
msgid "Remove leading and trailing characters in Series/Index."
msgstr "删除 Series/Index 中的前导和尾随字符。"

#: of pandas.core.strings.accessor.StringMethods.rstrip:21
msgid ":py:obj:`LiteFrame.str.lstrip`"
msgstr ""

#: of pandas.core.strings.accessor.StringMethods.rstrip:22
msgid "Remove leading characters in Series/Index."
msgstr "删除 Series/Index 中的前导字符。"

#: of pandas.core.strings.accessor.StringMethods.rstrip:24
msgid ":py:obj:`LiteFrame.str.rstrip`"
msgstr ""

#: of pandas.core.strings.accessor.StringMethods.rstrip:25
msgid "Remove trailing characters in Series/Index."
msgstr "删除 Series/Index 中的尾随字符。"

