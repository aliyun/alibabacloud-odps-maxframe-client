#: ../../source/reference/liteframe/generated/maxframe.liteframe.LiteFrame.str.rsplit.rst:2
msgid "maxframe.liteframe.LiteFrame.str.rsplit"
msgstr ""

#: of pandas.core.strings.accessor.StringMethods.rsplit:1
#: pandas.core.strings.accessor.StringMethods.rsplit:24
msgid "Split strings around given separator/delimiter."
msgstr "围绕给定分隔符拆分字符串。"

#: of pandas.core.strings.accessor.StringMethods.rsplit:3
msgid ""
"Splits the string in the Series/Index from the end, at the specified "
"delimiter string."
msgstr "从末尾开始在指定分隔符处分割 Series/Index 中的字符串。"

#: of pandas.core.strings.accessor.StringMethods.rsplit
msgid "参数"
msgstr ""

#: of pandas.core.strings.accessor.StringMethods.rsplit:6
msgid "String to split on. If not specified, split on whitespace."
msgstr "用于拆分的字符串。如果未指定，则按空白字符拆分。"

#: of pandas.core.strings.accessor.StringMethods.rsplit:9
msgid ""
"Limit number of splits in output. ``None``, 0 and -1 will be interpreted "
"as return all splits."
msgstr "限制输出中的拆分数。``None``、0 和 -1 将被解释为返回所有拆分。"

#: of pandas.core.strings.accessor.StringMethods.rsplit:12
msgid ""
"Expand the split strings into separate columns.  - If ``True``, return "
"DataFrame/MultiIndex expanding dimensionality. - If ``False``, return "
"Series/Index, containing lists of strings."
msgstr ""
"将拆分的字符串扩展到单独的列中。- 如果 ``True``，返回扩展维度的 DataFrame"
"/MultiIndex。- 如果 ``False``，返回包含字符串列表的 Series/Index。"

#: of pandas.core.strings.accessor.StringMethods.rsplit
msgid "返回"
msgstr ""

#: of pandas.core.strings.accessor.StringMethods.rsplit:18
msgid "Type matches caller unless ``expand=True`` (see Notes)."
msgstr "类型匹配调用者，除非 ``expand=True``（参见注释）。"

#: of pandas.core.strings.accessor.StringMethods.rsplit
msgid "返回类型"
msgstr ""

#: of pandas.core.strings.accessor.StringMethods.rsplit:23
msgid ":py:obj:`LiteFrame.str.split`"
msgstr ""

#: of pandas.core.strings.accessor.StringMethods.rsplit:26
msgid ":py:obj:`LiteFrame.str.rsplit`"
msgstr ""

#: of pandas.core.strings.accessor.StringMethods.rsplit:27
msgid "Splits string around given separator/delimiter, starting from the right."
msgstr "从右侧开始围绕给定分隔符拆分字符串。"

#: of pandas.core.strings.accessor.StringMethods.rsplit:29
msgid ":py:obj:`LiteFrame.str.join`"
msgstr ""

#: of pandas.core.strings.accessor.StringMethods.rsplit:30
msgid ""
"Join lists contained as elements in the Series/Index with passed "
"delimiter."
msgstr "使用传入的分隔符合并 Series/Index 中作为元素包含的列表。"

#: of pandas.core.strings.accessor.StringMethods.rsplit:32
msgid ":py:obj:`str.split`"
msgstr ""

#: of pandas.core.strings.accessor.StringMethods.rsplit:33
msgid "Standard library version for split."
msgstr "标准库版本的拆分。"

#: of pandas.core.strings.accessor.StringMethods.rsplit:35
msgid ":py:obj:`str.rsplit`"
msgstr ""

#: of pandas.core.strings.accessor.StringMethods.rsplit:36
msgid "Standard library version for rsplit."
msgstr "标准库版本的 rsplit。"

#: of pandas.core.strings.accessor.StringMethods.rsplit:39
msgid "备注"
msgstr ""

#: of pandas.core.strings.accessor.StringMethods.rsplit:40
msgid "The handling of the `n` keyword depends on the number of found splits:"
msgstr "`n` 关键字的处理取决于找到的拆分数："

#: of pandas.core.strings.accessor.StringMethods.rsplit:42
msgid "If found splits > `n`,  make first `n` splits only"
msgstr "如果找到的拆分数 > `n`，仅进行前 `n` 个拆分"

#: of pandas.core.strings.accessor.StringMethods.rsplit:43
msgid "If found splits <= `n`, make all splits"
msgstr "如果找到的拆分数 <= `n`，进行所有拆分"

#: of pandas.core.strings.accessor.StringMethods.rsplit:44
msgid ""
"If for a certain row the number of found splits < `n`, append `None` for "
"padding up to `n` if ``expand=True``"
msgstr ""
"如果对于某一行找到的拆分数 < `n`，如果 ``expand=True`` 则追加 `None` 填充"
"至 `n`"

#: of pandas.core.strings.accessor.StringMethods.rsplit:47
msgid ""
"If using ``expand=True``, Series and Index callers return DataFrame and "
"MultiIndex objects, respectively."
msgstr ""
"如果使用 ``expand=True``，Series 和 Index 调用者分别返回 DataFrame 和 "
"MultiIndex 对象。"


