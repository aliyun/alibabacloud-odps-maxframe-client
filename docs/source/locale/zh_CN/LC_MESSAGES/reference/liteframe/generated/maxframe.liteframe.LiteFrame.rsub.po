#: maxframe.liteframe.arithmetic.binary.rsub:1 of
msgid "Reverse element-wise subtraction (``other - lf``)."
msgstr "反向逐元素减法（``other - lf``）。"

#: maxframe.liteframe.arithmetic.binary.rsub:3 of
msgid ""
"Bound to ``__rsub__``, so ``other - lf`` is equivalent to "
"``lf.rsub(other)``."
msgstr "绑定到 ``__rsub__``，所以 ``other - lf`` 等价于 ``lf.rsub(other)``。"

#: maxframe.liteframe.arithmetic.binary.rsub of
msgid "参数"
msgstr ""

#: maxframe.liteframe.arithmetic.binary.rsub:6 of
msgid "Value from which each element of ``lf`` is subtracted."
msgstr "从其每个元素中减去 ``lf`` 元素的值。"

#: maxframe.liteframe.arithmetic.binary.rsub of
msgid "返回"
msgstr ""

#: maxframe.liteframe.arithmetic.binary.rsub:9 of
msgid "Lazy frame with element-wise difference of ``other`` and ``lf``."
msgstr "包含 ``other`` 和 ``lf`` 逐元素差值的惰性框架。"

