#: ../../source/reference/liteframe/generated/maxframe.liteframe.LiteFrame.to_json.rst:2
msgid "maxframe.liteframe.LiteFrame.to\\_json"
msgstr ""

#: maxframe.liteframe.datastore.to_json.to_json:1 of
msgid "Write a LiteFrame to JSON format (line-delimited by default)."
msgstr "将 LiteFrame 写入 JSON 格式（默认为行分隔）。"

#: ../../source/reference/liteframe/generated/maxframe.liteframe.LiteFrame.to_json.rst
msgid "参数"
msgstr ""

#: maxframe.liteframe.datastore.to_json.to_json:3 of
msgid ""
"File path. If path contains wildcard '*', each chunk writes to its own "
"file. If no wildcard, all data writes to a single file."
msgstr ""
"文件路径。如果路径包含通配符'*'，每个数据块写入其自己的文件。如果没有"
"通配符，所有数据写入单个文件。"

#: maxframe.liteframe.datastore.to_json.to_json:6 of
msgid ""
"Write line-delimited JSON (JSONL/NDJSON). Each row is a separate JSON "
"object on its own line."
msgstr "写入行分隔的 JSON（JSONL/NDJSON）。每行是一个独立的 JSON 对象。"

#: maxframe.liteframe.datastore.to_json.to_json:9 of
msgid "JSON orientation. Only 'records' is supported with lines=True."
msgstr "JSON 方向。当 lines=True 时仅支持 'records'。"

#: maxframe.liteframe.datastore.to_json.to_json:11 of
msgid "Compression to use for output file."
msgstr "用于输出文件的压缩方式。"

#: maxframe.liteframe.datastore.to_json.to_json:13 of
msgid "Column names by which to partition the dataset."
msgstr "用于分割数据集的列名。"

#: maxframe.liteframe.datastore.to_json.to_json:15 of
msgid "Extra options for storage connection."
msgstr "存储连接的额外选项。"

#: ../../source/reference/liteframe/generated/maxframe.liteframe.LiteFrame.to_json.rst
msgid "返回"
msgstr ""

#: maxframe.liteframe.datastore.to_json.to_json:18 of
msgid "Returns a stub LiteFrame for execution."
msgstr "返回一个用于执行的存根 LiteFrame。"

#: ../../source/reference/liteframe/generated/maxframe.liteframe.LiteFrame.to_json.rst
msgid "返回类型"
msgstr ""

#: maxframe.liteframe.datastore.to_json.to_json:23 of
msgid ":py:obj:`read_json`"
msgstr ""

#: maxframe.liteframe.datastore.to_json.to_json:24 of
msgid "Read a JSON file into a LiteFrame."
msgstr "将 JSON 文件读取到 LiteFrame 中。"

#: maxframe.liteframe.datastore.to_json.to_json:26 of
msgid ":py:obj:`to_csv`"
msgstr ""

#: maxframe.liteframe.datastore.to_json.to_json:27 of
msgid "Write a LiteFrame to a CSV file."
msgstr "将 LiteFrame 写入 CSV 文件。"

