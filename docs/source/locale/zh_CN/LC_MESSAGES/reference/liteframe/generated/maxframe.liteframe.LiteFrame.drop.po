#: ../../source/reference/liteframe/generated/maxframe.liteframe.LiteFrame.drop.rst:2
msgid "maxframe.liteframe.LiteFrame.drop"
msgstr ""

#: maxframe.liteframe.indexing.select.drop:1 of
msgid "Drop columns from LiteFrame."
msgstr "从 LiteFrame 中删除列。"

#: maxframe.liteframe.indexing.select.drop:3 of
msgid ""
"Removes the specified columns and returns a LiteFrame over the remaining "
"columns.  Hidden columns named in *columns* are also dropped.  Row order "
"is preserved."
msgstr ""
"删除指定的列并返回剩余列上的 LiteFrame。*columns* 中命名的隐藏列也会被"
"删除。行顺序得以保留。"

#: maxframe.liteframe.indexing.select.drop of
msgid "参数"
msgstr ""

#: maxframe.liteframe.indexing.select.drop:7 of
msgid "Column name(s) to drop."
msgstr "要删除的列名。"

#: maxframe.liteframe.indexing.select.drop:9 of
msgid ""
"When ``\"raise\"``, a ``KeyError`` is raised for unknown columns; when "
"``\"ignore\"``, unknown columns are silently skipped."
msgstr ""
"当为 ``\"raise\"`` 时，对未知列会引发 ``KeyError``；当为 ``\"ignore\"`` "
"时，未知列会被静默跳过。"

#: maxframe.liteframe.indexing.select.drop of
msgid "返回"
msgstr ""

#: maxframe.liteframe.indexing.select.drop:13 of
msgid "LiteFrame with the specified columns removed."
msgstr "删除了指定列的 LiteFrame。"

#: maxframe.liteframe.indexing.select.drop of
msgid "返回类型"
msgstr ""

#: maxframe.liteframe.indexing.select.drop:18 of
msgid ":py:obj:`LiteFrame.select`"
msgstr ""

#: maxframe.liteframe.indexing.select.drop:19 of
msgid "Explicit column selection."
msgstr "显式列选择。"

