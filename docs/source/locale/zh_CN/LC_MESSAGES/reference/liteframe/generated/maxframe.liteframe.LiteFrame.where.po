msgid "maxframe.liteframe.LiteFrame.where"
msgstr ""

#: maxframe.liteframe.arithmetic.where.where:1 of
msgid "Replace values where *cond* is False with *other*."
msgstr "在 *cond* 为 False 的位置用 *other* 替换值。"

#: maxframe.liteframe.arithmetic.where.where:3 of
msgid ""
"Equivalent to ``pandas.DataFrame.where``: keep original values where "
"*cond* is True, replace with *other* where False."
msgstr ""
"等价于 ``pandas.DataFrame.where``：在 *cond* 为 True 的位置保留原始值，在"
"为 False 的位置用 *other* 替换。"

#: maxframe.liteframe.arithmetic.where.where of
msgid "参数"
msgstr ""

#: maxframe.liteframe.arithmetic.where.where:6 of
msgid "Boolean LiteFrame (e.g. from ``lf > 2``) with the same columns."
msgstr "具有相同列的布尔型 LiteFrame（例如来自 ``lf > 2``）。"

#: maxframe.liteframe.arithmetic.where.where:8 of
msgid "Value to substitute where *cond* is False."
msgstr "在 *cond* 为 False 时用来替换的值。"

#: maxframe.liteframe.arithmetic.where.where of
msgid "返回类型"
msgstr ""

#: maxframe.liteframe.arithmetic.where.where:15 of
msgid ":py:obj:`mask`"
msgstr ""

#: maxframe.liteframe.arithmetic.where.where:16 of
msgid "Replace values where a condition is True."
msgstr "在条件为 True 时替换值。"

#: maxframe.liteframe.arithmetic.where.where:18 of
msgid ":py:obj:`case_when`"
msgstr ""

#: maxframe.liteframe.arithmetic.where.where:19 of
msgid "Replace values where conditions are True, in order."
msgstr "按顺序在条件为 True 时替换值。"

