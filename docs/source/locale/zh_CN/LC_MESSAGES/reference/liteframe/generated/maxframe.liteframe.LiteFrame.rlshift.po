#: maxframe.liteframe.arithmetic.binary.rlshift:1 of
msgid "Reverse element-wise left bit shift (``other << lf``)."
msgstr "反向逐元素左位移（``other << lf``）。"

#: maxframe.liteframe.arithmetic.binary.rlshift:3 of
msgid ""
"Bound to ``__rlshift__``, so ``other << lf`` is equivalent to "
"``lf.rlshift(other)``."
msgstr ""
"绑定到 ``__rlshift__``，所以 ``other << lf`` 等价于 ``lf.rlshift(other)``"
"。"

#: maxframe.liteframe.arithmetic.binary.rlshift of
msgid "参数"
msgstr ""

#: maxframe.liteframe.arithmetic.binary.rlshift:6 of
msgid "Integer value shifted left by each element of ``lf``."
msgstr "被 ``lf`` 的每个元素左移的整数值。"

#: maxframe.liteframe.arithmetic.binary.rlshift of
msgid "返回"
msgstr ""

#: maxframe.liteframe.arithmetic.binary.rlshift:9 of
msgid "Lazy frame with ``other`` shifted left by each element of ``lf``."
msgstr "带有 ``other`` 被 ``lf`` 的每个元素左移的惰性框架。"

