#: maxframe.liteframe.arithmetic.where.mask:1 of
msgid "Replace values where *cond* is True with *other*."
msgstr "在 *cond* 为 True 的位置用 *other* 替换值。"

#: maxframe.liteframe.arithmetic.where.mask:3 of
msgid ""
"Equivalent to ``pandas.DataFrame.mask``: replace original values where "
"*cond* is True with *other*, keep where False."
msgstr ""
"等价于 ``pandas.DataFrame.mask``：在 *cond* 为 True 的位置用 *other* 替换"
"原始值，在为 False 的位置保持原值。"

#: maxframe.liteframe.arithmetic.where.mask of
msgid "参数"
msgstr ""

#: maxframe.liteframe.arithmetic.where.mask:6 of
msgid "Boolean LiteFrame (e.g. from ``lf > 2``) with the same columns."
msgstr "具有相同列的布尔型 LiteFrame（例如来自 ``lf > 2``）。"

#: maxframe.liteframe.arithmetic.where.mask:8 of
msgid "Value to substitute where *cond* is True."
msgstr "在 *cond* 为 True 时用于替换的值。"

#: maxframe.liteframe.arithmetic.where.mask of
msgid "返回类型"
msgstr ""

#: maxframe.liteframe.arithmetic.where.mask:15 of
msgid ":py:obj:`where`"
msgstr ""

#: maxframe.liteframe.arithmetic.where.mask:16 of
msgid "Replace values where a condition is False."
msgstr "在条件为 False 时替换值。"

#: maxframe.liteframe.arithmetic.where.mask:18 of
msgid ":py:obj:`case_when`"
msgstr ""

#: maxframe.liteframe.arithmetic.where.mask:19 of
msgid "Replace values where conditions are True, in order."
msgstr "按顺序在条件为 True 时替换值。"

