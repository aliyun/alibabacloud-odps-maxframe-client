#: ../../source/reference/liteframe/generated/maxframe.liteframe.LiteFrame.str.isdigit.rst:2
msgid "maxframe.liteframe.LiteFrame.str.isdigit"
msgstr ""

#: of pandas.core.strings.accessor.StringMethods.isdigit:1
msgid "Check whether all characters in each string are digits."
msgstr "检查每个字符串中的所有字符是否都是数字。"

#: of pandas.core.strings.accessor.StringMethods.isdigit:3
msgid ""
"This is equivalent to running the Python string method "
":meth:`str.isdigit` for each element of the Series/Index. If a string has"
" zero characters, ``False`` is returned for that check."
msgstr ""
"这相当于对 Series/Index 的每个元素运行 Python 字符串方法 :meth:`str."
"isdigit`。如果字符串没有字符，则该检查返回 ``False``。"

#: of pandas.core.strings.accessor.StringMethods.isdigit
msgid "返回"
msgstr ""

#: of pandas.core.strings.accessor.StringMethods.isdigit:7
msgid ""
"Series or Index of boolean values with the same length as the original "
"Series/Index."
msgstr "与原始 Series/Index 长度相同的布尔值 Series 或 Index。"

#: of pandas.core.strings.accessor.StringMethods.isdigit
msgid "返回类型"
msgstr ""

