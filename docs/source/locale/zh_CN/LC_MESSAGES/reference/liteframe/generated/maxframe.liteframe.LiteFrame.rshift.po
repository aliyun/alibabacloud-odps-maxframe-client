msgid "maxframe.liteframe.LiteFrame.rshift"
msgstr ""

#: maxframe.liteframe.arithmetic.binary.rshift:1 of
msgid "Element-wise right bit shift (``lf >> other``)."
msgstr "逐元素右移位运算（``lf >> other``）。"

#: maxframe.liteframe.arithmetic.binary.rshift:3 of
msgid ""
"Bound to the ``>>`` operator (``__rshift__``), so ``lf >> other`` is "
"equivalent to ``lf.rshift(other)``."
msgstr ""
"绑定到 ``>>`` 运算符（``__rshift__``），因此 ``lf >> other`` 等价于 ``lf."
"rshift(other)``。"

#: maxframe.liteframe.arithmetic.binary.rshift of
msgid "参数"
msgstr ""

#: maxframe.liteframe.arithmetic.binary.rshift:6 of
msgid "Number of bit positions to shift right."
msgstr "向右移动的位数。"

#: maxframe.liteframe.arithmetic.binary.rshift of
msgid "返回"
msgstr ""

#: maxframe.liteframe.arithmetic.binary.rshift:9 of
msgid "Lazy frame with each element of ``lf`` shifted right by ``other``."
msgstr "每个元素都向右移动 ``other`` 位的惰性框架。"

#: maxframe.liteframe.arithmetic.binary.rshift of
msgid "返回类型"
msgstr ""

