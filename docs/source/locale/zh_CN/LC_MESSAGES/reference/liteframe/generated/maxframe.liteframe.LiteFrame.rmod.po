#: maxframe.liteframe.arithmetic.binary.rmod:1 of
#, python-format
msgid "Reverse element-wise modulo (``other % lf``)."
msgstr "反向元素级取模运算（``other % lf``）。"

#: maxframe.liteframe.arithmetic.binary.rmod:3 of
#, python-format
msgid ""
"Bound to ``__rmod__``, so ``other % lf`` is equivalent to "
"``lf.rmod(other)``."
msgstr "绑定到 ``__rmod__``，所以 ``other % lf`` 等价于 ``lf.rmod(other)``。"

#: maxframe.liteframe.arithmetic.binary.rmod of
msgid "参数"
msgstr ""

#: maxframe.liteframe.arithmetic.binary.rmod:6 of
msgid "Value whose remainder is taken modulo each element of ``lf``."
msgstr "对 ``lf`` 的每个元素取模后得到余数的值。"

#: maxframe.liteframe.arithmetic.binary.rmod of
msgid "返回"
msgstr ""

#: maxframe.liteframe.arithmetic.binary.rmod:9 of
msgid "Lazy frame with element-wise remainder of ``other`` divided by ``lf``."
msgstr "包含 ``other`` 除以 ``lf`` 元素级余数的惰性帧。"

