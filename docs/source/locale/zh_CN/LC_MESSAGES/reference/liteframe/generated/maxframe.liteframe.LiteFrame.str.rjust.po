msgid "maxframe.liteframe.LiteFrame.str.rjust"
msgstr ""

#: of pandas.core.strings.accessor.StringMethods.rjust:1
msgid "Pad left side of strings in the Series/Index."
msgstr "填充 Series/Index 中字符串的左侧。"

#: of pandas.core.strings.accessor.StringMethods.rjust:3
msgid "Equivalent to :meth:`str.rjust`."
msgstr "等价于 :meth:`str.rjust`。"

#: ../../source/reference/liteframe/generated/maxframe.liteframe.LiteFrame.str.rjust.rst
msgid "参数"
msgstr ""

#: of pandas.core.strings.accessor.StringMethods.rjust:5
msgid ""
"Minimum width of resulting string; additional characters will be filled "
"with ``fillchar``."
msgstr "结果字符串的最小宽度；额外的字符将用 ``fillchar`` 填充。"

#: of pandas.core.strings.accessor.StringMethods.rjust:8
msgid "Additional character for filling, default is whitespace."
msgstr "用于填充的附加字符，默认为空白字符。"

#: ../../source/reference/liteframe/generated/maxframe.liteframe.LiteFrame.str.rjust.rst
msgid "返回"
msgstr ""

#: of pandas.core.strings.accessor.StringMethods.rjust:11
msgid "A Series or Index where the strings are modified by :meth:`str.rjust`."
msgstr ""

#: ../../source/reference/liteframe/generated/maxframe.liteframe.LiteFrame.str.rjust.rst
msgid "返回类型"
msgstr ""

#: of pandas.core.strings.accessor.StringMethods.rjust:16
msgid ":py:obj:`LiteFrame.str.rjust`"
msgstr ""

#: of pandas.core.strings.accessor.StringMethods.rjust:17
msgid "Fills the left side of strings with an arbitrary character."
msgstr "用任意字符填充字符串的左侧。"

#: of pandas.core.strings.accessor.StringMethods.rjust:19
msgid ":py:obj:`LiteFrame.str.ljust`"
msgstr ""

#: of pandas.core.strings.accessor.StringMethods.rjust:20
msgid "Fills the right side of strings with an arbitrary character."
msgstr "用任意字符填充字符串的右侧。"

#: of pandas.core.strings.accessor.StringMethods.rjust:22
msgid ":py:obj:`LiteFrame.str.center`"
msgstr ""

#: of pandas.core.strings.accessor.StringMethods.rjust:23
msgid "Fills both sides of strings with an arbitrary character."
