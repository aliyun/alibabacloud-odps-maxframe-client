#: ../../source/reference/liteframe/generated/maxframe.liteframe.LiteFrame.value_counts.rst:2
msgid "maxframe.liteframe.LiteFrame.value\\_counts"
msgstr ""

#: maxframe.liteframe.reduction.value_counts.value_counts:1 of
msgid "Return a LiteFrame containing counts of unique values."
msgstr "返回包含唯一值计数的 LiteFrame。"

#: maxframe.liteframe.reduction.value_counts.value_counts of
msgid "参数"
msgstr ""

#: maxframe.liteframe.reduction.value_counts.value_counts:3 of
msgid ""
"Column(s) whose distinct value combinations are counted.  If None, all "
"columns are used."
msgstr "要计数的列，基于其不同值的组合。如果为 None，使用所有列。"

#: maxframe.liteframe.reduction.value_counts.value_counts:6 of
msgid ""
"If True, return relative frequencies (proportions) instead of counts.  "
"The output column is named ``\"proportion\"`` (float64) instead of "
"``\"count\"`` (int64)."
msgstr ""
"如果为 True，返回相对频率（比例）而非计数。输出列名为 ``\"proportion\"``"
"（float64）而非 ``\"count\"``（int64）。"

#: maxframe.liteframe.reduction.value_counts.value_counts:10 of
msgid "Sort by count/proportion."
msgstr "按计数/比例排序。"

#: maxframe.liteframe.reduction.value_counts.value_counts:12 of
msgid "Sort order (descending by default, matching pandas)."
msgstr "排序顺序（默认降序，与 pandas 一致）。"

#: maxframe.liteframe.reduction.value_counts.value_counts:14 of
msgid "Exclude null-key rows."
msgstr "排除键为空的行。"

#: maxframe.liteframe.reduction.value_counts.value_counts of
msgid "返回"
msgstr ""

#: maxframe.liteframe.reduction.value_counts.value_counts:17 of
msgid ""
"Frame with the value column(s) and a ``\"count\"`` or ``\"proportion\"`` "
"column."
msgstr "包含值列和 ``\"count\"`` 或 ``\"proportion\"`` 列的帧。"

#: maxframe.liteframe.reduction.value_counts.value_counts of
msgid "返回类型"
msgstr ""

