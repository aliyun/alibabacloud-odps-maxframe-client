#: ../../source/reference/liteframe/generated/maxframe.liteframe.LiteFrame.select_dtypes.rst:2
msgid "maxframe.liteframe.LiteFrame.select\\_dtypes"
msgstr ""

#: maxframe.liteframe.indexing.select.select_dtypes:1 of
msgid "Subset columns based on their dtype."
msgstr "根据数据类型筛选列。"

#: maxframe.liteframe.indexing.select.select_dtypes:0 of
msgid "参数"
msgstr ""

#: maxframe.liteframe.indexing.select.select_dtypes:3 of
msgid ""
"Dtype kind(s) to include.  Accepts string aliases (``\"number\"``, "
"``\"integer\"``, ``\"floating\"``, ``\"int\"``, ``\"float\"``, "
"``\"bool\"``, ``\"datetime\"``, ``\"datetime64\"``, ``\"timedelta\"``, "
"``\"object\"``, ``\"string\"``, ``\"category\"``), numpy types "
"(``np.int64``), builtin types (``int``, ``float``), or ``np.dtype`` "
"instances."
msgstr ""
"要包含的数据类型种类。接受字符串别名（``\"number\"``、``\"integer\"``、``"
"\"floating\"``、``\"int\"``、``\"float\"``、``\"bool\"``、``\"datetime\"`"
"`、``\"datetime64\"``、``\"timedelta\"``、``\"object\"``、``\"string\"``"
"、``\"category\"``）、numpy 类型（``np.int64``）、内置类型（``int``、``"
"float``）或 ``np.dtype`` 实例。"

#: maxframe.liteframe.indexing.select.select_dtypes:9 of
msgid "Dtype kind(s) to exclude.  Same spec forms as *include*."
msgstr "要排除的数据类型种类。与 *include* 使用相同的规范形式。"

#: maxframe.liteframe.indexing.select.select_dtypes:0 of
msgid "返回"
msgstr ""

#: maxframe.liteframe.indexing.select.select_dtypes:12 of
msgid "LiteFrame with only the matching columns, preserving row order."
msgstr "仅包含匹配列的 LiteFrame，保持行顺序。"

#: maxframe.liteframe.indexing.select.select_dtypes:0 of
msgid "返回类型"
msgstr ""

#: maxframe.liteframe.indexing.select.select_dtypes:0 of
msgid "抛出"
msgstr ""

#: maxframe.liteframe.indexing.select.select_dtypes:15 of
msgid "If neither *include* nor *exclude* is specified."
msgstr "当 *include* 与 *exclude* 均未指定时抛出。"

