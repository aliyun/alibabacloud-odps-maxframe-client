#: ../../source/reference/liteframe/generated/maxframe.liteframe.LiteFrame.idxmin.rst:2
msgid "maxframe.liteframe.LiteFrame.idxmin"
msgstr ""

#: maxframe.liteframe.reduction.agg.idxmin:1 of
msgid "Return the row index of the minimum value in each column."
msgstr "返回每列最小值的行索引。"

#: maxframe.liteframe.reduction.agg.idxmin:2 of
msgid ""
"The index is the 0-based integer row position in the original frame "
"(range-index value).  Ties are broken by first occurrence."
msgstr ""
"索引是原始帧中从 0 开始的整数行位置（range-index 值）。相同值取首次出现"
"的位置。"

#: maxframe.liteframe.reduction.agg.idxmin of
msgid "参数"
msgstr ""

#: maxframe.liteframe.reduction.agg.idxmin:3 of
msgid "Execution strategy.  ``'auto'`` selects based on data size."
msgstr "执行策略。``'auto'`` 根据数据大小进行选择。"

#: maxframe.liteframe.reduction.agg.idxmin:4 of
msgid ""
"Exclude NA/null values. If False, and any value is NA, the result is NA."
msgstr "排除 NA/null 值。如果为 False，且任何值为 NA，则结果为 NA。"

#: maxframe.liteframe.reduction.agg.idxmin:5 of
msgid "Additional keyword arguments forwarded to the reduction."
msgstr "转发给归约的额外关键字参数。"

#: maxframe.liteframe.reduction.agg.idxmin of
msgid "返回"
msgstr ""

#: maxframe.liteframe.reduction.agg.idxmin:6 of
msgid "Single-row LiteFrame of per-column minimum-value row indices."
msgstr "每列最小值行索引的单行 LiteFrame。"

#: maxframe.liteframe.reduction.agg.idxmin of
msgid "返回类型"
msgstr ""

