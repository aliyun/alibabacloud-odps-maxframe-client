#: ../../source/reference/liteframe/generated/maxframe.liteframe.LiteFrame.str.strip.rst:2
msgid "maxframe.liteframe.LiteFrame.str.strip"
msgstr ""

#: of pandas.core.strings.accessor.StringMethods.strip:1
msgid "Remove leading and trailing characters."
msgstr "移除前导和尾随字符。"

#: of pandas.core.strings.accessor.StringMethods.strip:3
msgid ""
"Strip whitespaces (including newlines) or a set of specified characters "
"from each string in the Series/Index from left and right sides. Replaces "
"any non-strings in Series with NaNs. Equivalent to :meth:`str.strip`."
msgstr ""
"从 Series/Index 中的每个字符串的左右两侧剥离空白字符（包括换行符）或一组"
"指定字符。将 Series 中的非字符串替换为 NaNs。等价于 :meth:`str.strip`。"

#: ../../source/reference/liteframe/generated/maxframe.liteframe.LiteFrame.str.strip.rst
msgid "参数"
msgstr ""

#: of pandas.core.strings.accessor.StringMethods.strip:8
msgid ""
"Specifying the set of characters to be removed. All combinations of this "
"set of characters will be stripped. If None then whitespaces are removed."
msgstr ""
"指定要移除的字符集。该字符集的所有组合都将被剥离。如果为 None 则移除空白"
"字符。"

#: ../../source/reference/liteframe/generated/maxframe.liteframe.LiteFrame.str.strip.rst
msgid "返回"
msgstr ""

#: of pandas.core.strings.accessor.StringMethods.strip:13
msgid ""
"Series or Index with the strings being stripped from the left and right "
"sides."
msgstr "Series 或 Index，其字符串从左右两侧被剥离。"

#: ../../source/reference/liteframe/generated/maxframe.liteframe.LiteFrame.str.strip.rst
msgid "返回类型"
msgstr ""

#: of pandas.core.strings.accessor.StringMethods.strip:19
msgid ":py:obj:`LiteFrame.str.strip`"
msgstr ""

#: of pandas.core.strings.accessor.StringMethods.strip:20
msgid "Remove leading and trailing characters in Series/Index."
msgstr "移除 Series/Index 中的前导和尾随字符。"

#: of pandas.core.strings.accessor.StringMethods.strip:22
msgid ":py:obj:`LiteFrame.str.lstrip`"
msgstr ""

#: of pandas.core.strings.accessor.StringMethods.strip:23
msgid "Remove leading characters in Series/Index."
msgstr "移除 Series/Index 中的前导字符。"

#: of pandas.core.strings.accessor.StringMethods.strip:25
msgid ":py:obj:`LiteFrame.str.rstrip`"
msgstr ""

#: of pandas.core.strings.accessor.StringMethods.strip:26
msgid "Remove trailing characters in Series/Index."
msgstr "移除 Series/Index 中的尾随字符。"
