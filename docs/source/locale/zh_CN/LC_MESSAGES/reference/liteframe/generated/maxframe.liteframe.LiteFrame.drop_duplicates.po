#: ../../source/reference/liteframe/generated/maxframe.liteframe.LiteFrame.drop_duplicates.rst:2
msgid "maxframe.liteframe.LiteFrame.drop\\_duplicates"
msgstr ""

#: maxframe.liteframe.misc.drop_duplicates.drop_duplicates:1 of
msgid "Return LiteFrame with duplicate rows removed."
msgstr "返回移除重复行的 LiteFrame。"

#: maxframe.liteframe.misc.drop_duplicates.drop_duplicates of
msgid "参数"
msgstr ""

#: maxframe.liteframe.misc.drop_duplicates.drop_duplicates:3 of
msgid ""
"Only consider certain columns for identifying duplicates, by default use "
"all columns."
msgstr "仅考虑特定列来识别重复项，默认使用所有列。"

#: maxframe.liteframe.misc.drop_duplicates.drop_duplicates:6 of
msgid ""
"- ``first``: drop duplicates except the first occurrence. - ``last``: "
"drop duplicates except the last occurrence. - ``False``: drop all "
"duplicates."
msgstr ""
"- ``first``：保留第一次出现的重复项，删除其余重复项。- ``last``：保留最后"
"一次出现的重复项，删除其余重复项。- ``False``：删除所有重复项。"

#: maxframe.liteframe.misc.drop_duplicates.drop_duplicates:7 of
msgid "``first``: drop duplicates except the first occurrence."
msgstr "``first``：保留第一次出现的重复项，删除其余重复项。"

#: maxframe.liteframe.misc.drop_duplicates.drop_duplicates:8 of
msgid "``last``: drop duplicates except the last occurrence."
msgstr "``last``：保留最后一次出现的重复项，删除其余重复项。"

#: maxframe.liteframe.misc.drop_duplicates.drop_duplicates:9 of
msgid "``False``: drop all duplicates."
msgstr "``False``：删除所有重复项。"

#: maxframe.liteframe.misc.drop_duplicates.drop_duplicates:11 of
msgid "Tiling strategy for multi-chunk inputs."
msgstr "多块输入的分块策略。"

#: maxframe.liteframe.misc.drop_duplicates.drop_duplicates of
msgid "返回"
msgstr ""

#: maxframe.liteframe.misc.drop_duplicates.drop_duplicates:14 of
msgid "Deduplicated LiteFrame."
msgstr "去重后的 LiteFrame。"

#: maxframe.liteframe.misc.drop_duplicates.drop_duplicates of
msgid "返回类型"
msgstr ""

#: maxframe.liteframe.misc.drop_duplicates.drop_duplicates:19 of
msgid ":py:obj:`duplicated`"
msgstr ""

#: maxframe.liteframe.misc.drop_duplicates.drop_duplicates:20 of
msgid "Return boolean mask marking duplicate rows."
msgstr "返回标记重复行的布尔掩码。"

#: maxframe.liteframe.misc.drop_duplicates.drop_duplicates:22 of
msgid ":py:obj:`sort`"
msgstr ""

#: maxframe.liteframe.misc.drop_duplicates.drop_duplicates:23 of
msgid "Sort the LiteFrame by columns."
msgstr "按列对 LiteFrame 进行排序。"

