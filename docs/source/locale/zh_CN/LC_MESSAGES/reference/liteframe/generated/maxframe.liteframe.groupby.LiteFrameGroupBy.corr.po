#: ../../source/reference/liteframe/generated/maxframe.liteframe.groupby.LiteFrameGroupBy.corr.rst:2
msgid "maxframe.liteframe.groupby.LiteFrameGroupBy.corr"
msgstr ""

#: maxframe.liteframe.groupby.core.LiteFrameGroupBy.corr:1 of
msgid "Compute pairwise correlation matrix per group."
msgstr "计算每组的成对相关系数矩阵。"

#: maxframe.liteframe.groupby.core.LiteFrameGroupBy.corr:2 of
msgid "Delta degrees of freedom for the covariance/std denominator."
msgstr "协方差/标准差分母的自由度增量。"

#: maxframe.liteframe.groupby.core.LiteFrameGroupBy.corr:3 of
msgid ""
"If True, exclude non-numeric columns.  If False (pandas 2.0+ "
"default), non-numeric target columns raise TypeError."
msgstr ""
"如果为 True，排除非数值列。如果为 False（pandas 2.0+ 默认值），"
"非数值目标列会引发 TypeError。"

#: maxframe.liteframe.groupby.core.LiteFrameGroupBy.corr:4 of
msgid "Minimum non-null observations per pair; below this, NaN."
msgstr "每对非空观测值的最小数量；低于此值返回 NaN。"

#: maxframe.liteframe.groupby.core.LiteFrameGroupBy.corr:5 of
msgid "Additional keyword arguments forwarded to :meth:`agg`."
msgstr "转发给 :meth:`agg` 的额外关键字参数。"

#: maxframe.liteframe.groupby.core.LiteFrameGroupBy.corr of
msgid "返回"
msgstr ""

#: maxframe.liteframe.groupby.core.LiteFrameGroupBy.corr:6 of
msgid ""
"Matrix with group key, ``columns`` row-label, and one column "
"per numeric column.  The diagonal is always 1.0."
msgstr ""
"包含组键、``columns`` 行标签和每个数值列一个列的矩阵。"
"对角线始终为 1.0。"

#: maxframe.liteframe.groupby.core.LiteFrameGroupBy.corr of
msgid "返回类型"
msgstr ""

