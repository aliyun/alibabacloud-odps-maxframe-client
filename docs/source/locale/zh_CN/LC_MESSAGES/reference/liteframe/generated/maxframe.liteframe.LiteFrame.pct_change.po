#: ../../source/reference/liteframe/generated/maxframe.liteframe.LiteFrame.pct_change.rst:2
msgid "maxframe.liteframe.LiteFrame.pct\\_change"
msgstr ""

#: maxframe.liteframe.window.pct_change.pct_change:1 of
msgid "Compute ``(x[i] - x[i-periods]) / x[i-periods]`` for each row."
msgstr "为每一行计算 ``(x[i] - x[i-periods]) / x[i-periods]``"

#: maxframe.liteframe.window.pct_change.pct_change:3 of
msgid ""
"First ``periods`` rows (for positive periods) or last ``|periods|`` rows "
"(for negative periods) are null.  Division by zero produces null/inf "
"following Polars arithmetic semantics."
msgstr ""
"前 ``periods`` 行（对于正周期）或最后 ``|periods|`` 行（对于负周期）为"
"null。根据Polars算术语义，除以零会产生null/inf。"

#: maxframe.liteframe.window.pct_change.pct_change of
msgid "参数"
msgstr ""

#: maxframe.liteframe.window.pct_change.pct_change:7 of
msgid ""
"Number of positions for pct_change.  Positive = forward, negative = "
"backward."
msgstr "pct_change的位置数。正数=向前，负数=向后。"

#: maxframe.liteframe.window.pct_change.pct_change:10 of
msgid ""
"Column(s) for pct_change.  If None, all columns are transformed. Non-"
"selected columns are passed through unchanged."
msgstr "用于pct_change的列。如果为None，则转换所有列。未选择的列保持不变。"

#: maxframe.liteframe.window.pct_change.pct_change of
msgid "返回"
msgstr ""

#: maxframe.liteframe.window.pct_change.pct_change:14 of
msgid "Pct-change LiteFrame with same shape.  Transformed columns become Float64."
msgstr "具有相同形状的Pct-change LiteFrame。转换后的列变为Float64。"

#: maxframe.liteframe.window.pct_change.pct_change of
msgid "返回类型"
msgstr ""

#: maxframe.liteframe.window.pct_change.pct_change of
msgid "抛出"
msgstr ""

#: maxframe.liteframe.window.pct_change.pct_change:18 of
msgid "If any transformed column is non-numeric."
msgstr "如果任何转换后的列不是数值型。"

#: maxframe.liteframe.window.pct_change.pct_change:22 of
msgid ":py:obj:`diff`"
msgstr ""

#: maxframe.liteframe.window.pct_change.pct_change:23 of
msgid "Compute the difference between consecutive rows."
msgstr "计算连续行之间的差值。"

#: maxframe.liteframe.window.pct_change.pct_change:25 of
msgid ":py:obj:`shift`"
msgstr ""

#: maxframe.liteframe.window.pct_change.pct_change:26 of
msgid "Shift rows by a given number of periods."
msgstr "按给定的周期数移动行。"

