msgid "maxframe.liteframe.LiteFrame.lshift"
msgstr ""

#: maxframe.liteframe.arithmetic.binary.lshift:1 of
msgid "Element-wise left bit shift (``lf << other``)."
msgstr "元素级左位移（``lf << other``）。"

#: maxframe.liteframe.arithmetic.binary.lshift:3 of
msgid ""
"Bound to the ``<<`` operator (``__lshift__``), so ``lf << other`` is "
"equivalent to ``lf.lshift(other)``."
msgstr ""
"绑定到 ``<<`` 运算符（``__lshift__``），因此 ``lf << other`` 等价于 ``lf."
"lshift(other)``。"

#: maxframe.liteframe.arithmetic.binary.lshift of
msgid "参数"
msgstr ""

#: maxframe.liteframe.arithmetic.binary.lshift:6 of
msgid "Number of bit positions to shift left."
msgstr "向左移动的位数。"

#: maxframe.liteframe.arithmetic.binary.lshift of
msgid "返回"
msgstr ""

#: maxframe.liteframe.arithmetic.binary.lshift:9 of
msgid "Lazy frame with each element of ``lf`` shifted left by ``other``."
msgstr "每个元素都向左移动 ``other`` 位的惰性框架。"

#: maxframe.liteframe.arithmetic.binary.lshift of
msgid "返回类型"
msgstr ""

