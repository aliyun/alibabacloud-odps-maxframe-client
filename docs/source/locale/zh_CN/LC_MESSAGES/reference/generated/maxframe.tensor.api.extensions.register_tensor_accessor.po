#: ../../source/reference/generated/maxframe.tensor.api.extensions.register_tensor_accessor.rst:2
msgid "maxframe.tensor.api.extensions.register\\_tensor\\_accessor"
msgstr ""

#: maxframe.tensor.core.register_tensor_accessor:1 of
msgid "Register a custom accessor on Tensor objects."
msgstr "在 Tensor 对象上注册自定义访问器。"

#: maxframe.tensor.core.register_tensor_accessor of
msgid "参数"
msgstr ""

#: maxframe.tensor.core.register_tensor_accessor:3 of
msgid ""
"Name the accessor is registered under. Must be a valid identifier that "
"does not start with an underscore. Registering a name that is already "
"registered for tensors raises ``AttributeError`` unless ``override`` is "
"True."
msgstr ""
"访问器注册使用的名称。必须是以下划线以外的合法标识符。注册已注册的名称会"
"引发 ``AttributeError``，除非 ``override`` 为 True。"

#: maxframe.tensor.core.register_tensor_accessor:8 of
msgid ""
"Replace an accessor previously registered under the same name; a warning "
"is issued when an existing accessor is replaced. Attributes owned by "
"MaxFrame itself cannot be overridden."
msgstr ""
"替换此前以相同名称注册的访问器；替换现有访问器时会发出警告。MaxFrame 自身"
"拥有的属性无法被覆盖。"

#: maxframe.tensor.core.register_tensor_accessor of
msgid "返回"
msgstr ""

#: maxframe.tensor.core.register_tensor_accessor:13 of
msgid ""
"A class decorator that installs the accessor and returns the class "
"unchanged."
msgstr "类装饰器，用于安装该访问器并原样返回该类。"

#: maxframe.tensor.core.register_tensor_accessor of
msgid "返回类型"
msgstr ""

#: maxframe.tensor.core.register_tensor_accessor:19 of
msgid ":py:obj:`register_accessor`"
msgstr ""

#: maxframe.tensor.core.register_tensor_accessor:20 of
msgid "Register a custom accessor on arbitrary tileable classes."
msgstr "在任意 tileable 类上注册自定义访问器。"

